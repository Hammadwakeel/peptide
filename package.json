{
  "name": "frontier-nexus-rx",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --dir frontend build",
    "dev": "pnpm --dir frontend dev",
    "start": "pnpm --dir frontend start",
    "lint": "pnpm --dir frontend lint",
    "vercel-build": "pnpm --dir frontend build",
    "push:hasnain": "git push frontier-nexus main",
    "push:hammad": "git subtree split --prefix=frontend -b frontend-only && git push origin frontend-only:main --force",
    "push:all": "pnpm push:hasnain && pnpm push:hammad"
  }
}
