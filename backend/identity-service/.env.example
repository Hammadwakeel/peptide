JWT_SECRET=frontier-identity-jwt-secret-change-in-production
JWT_REFRESH_SECRET=frontier-identity-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
# Re-verify OTP on login only after this many minutes since last verification (12000 = 200 hours)
LOGIN_OTP_REVERIFY_MINUTES=12000
FRONTEND_URL=http://localhost:3000
INVITE_EXPIRY_DAYS=7
# Validity window (hours) for the set-password link sent after admin approval
PASSWORD_SETUP_EXPIRY_HOURS=48