# ---- Database ----
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/sql-data
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600

# ---- S3 Storage ----
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=eu-north-1
S3_BUCKET_NAME=frontier-biomed-public-assets

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Frontier Nexus Rx <your-email@gmail.com>"
