# Shared backend environment (all nano services)
NODE_ENV=development

# PostgreSQL — Cloud SQL
CLOUD_SQL_INSTANCE=glowing-arcadia-498617-m2:us-central1:frontier123
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sql-data
DB_POOL_SIZE=10

# Service ports
IDENTITY_SERVICE_PORT=3001
COMMERCE_SERVICE_PORT=3002
COMMUNICATION_SERVICE_PORT=3003

# GCP credentials (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./database/your-service-account.json
