COMMUNICATION_SERVICE_PORT=3003
JWT_SECRET=frontier-identity-jwt-secret-change-in-production

# PostgreSQL (shared main DB — conversations metadata only)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/sql-data

# MongoDB (chat messages)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/frontien_chats?retryWrites=true&w=majority
MONGODB_DB_NAME=frontien_chats

# Redis (real-time fan-out)
REDIS_URL=redis://default:password@host:port

# Kafka (Aiven)
KAFKA_BOOTSTRAP_SERVERS=your-host:26614
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SSL_CA_LOCATION=kafka.pem
KAFKA_SSL_ENDPOINT_ALGORITHM=none
# false for local dev (Avast/antivirus SSL scan); true in production with correct ca.pem
KAFKA_SSL_VERIFY=false
KAFKA_TOPIC=chats
KAFKA_CONSUMER_GROUP=communication-service

# S3 (chat media uploads)
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
# false for local dev (Avast/antivirus SSL scan); true in production
S3_SSL_VERIFY=false

# Chat message pagination (GET /conversations/{id}/messages?limit=30&before_id=...)
CHAT_MESSAGES_DEFAULT_LIMIT=20
CHAT_MESSAGES_MAX_LIMIT=100
